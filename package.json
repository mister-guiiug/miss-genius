{
  "name": "miss-genius",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "description": "Miss Genius — PWA mobile-first de simulation de moyennes scolaires (matières, notes, scénarios, objectifs). Local-first, installable, hors ligne.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget",
    "build:analyze": "cross-env ANALYZE=1 npm run build",
    "preview": "vite preview --base /miss-genius/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc -b",
    "icons": "pwa-icons --source public/icons/icon.svg --out public/icons --sizes 192,512 --no-apple",
    "icons:maskable": "node scripts/generate-maskable.mjs",
    "prepare": "husky || true",
    "test:e2e": "playwright test"
  },
  "bundleBudget": {
    "totalGzipKb": 423,
    "preloadGzipKb": 187,
    "_pourquoiPreload": "Posé le 16/09/2026 avec Sentry, socle 4.18.0. Le total compte les morceaux ASYNCHRONES : il monte de 255 à 423 kB par la seule installation du SDK, alors que le chemin critique ne bouge pas. Sans cette seconde borne, ~151 kB de mou couvriraient toute régression. Mesuré 169.6 kB, budget à +10 %."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@mister-guiiug/dev-pwa-config": "^4.21.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@rive-app/react-webgl2": "^4.34.3",
    "@sentry/react": "^10.75.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
