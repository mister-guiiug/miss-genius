# URL du proxy Pronote (Cloudflare Worker) — voir worker/README.md.
# Laisser vide pour désactiver le connecteur (l'app propose alors la démo).
VITE_PRONOTE_PROXY_URL=

# Optional: error monitoring via Sentry. Leave empty to disable (no-op,
# the @sentry/react peer is never loaded). Set your DSN to activate.
VITE_SENTRY_DSN=
