# Engendré par `pwa-env sync` depuis config/env.manifest.json.
# App : miss-genius
# Ne pas éditer à la main : modifier le manifeste, puis relancer sync --write.

# Clé projet PostHog (nuage EU)
# Repli : absent : pas de mesure ni bandeau
VITE_POSTHOG_KEY=

# Proxy Pronote
VITE_PRONOTE_PROXY_URL=

# DSN Sentry
# Repli : absent : no-op
VITE_SENTRY_DSN=
